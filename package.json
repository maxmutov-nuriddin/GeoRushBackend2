{
  "name": "georush-backend",
  "version": "1.0.0",
  "description": "GeoRush - Real-life territory capture game backend",
  "main": "server.js",
  "scripts": {
    "postinstall": "npx prisma generate && npx prisma db push",
    "build": "npx prisma generate && npx prisma db push",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:debug": "nodemon --inspect server.js",
    "test": "node --test tests/*.test.js",
    "test:unit": "node --test tests/geo.test.js tests/anticheat.test.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.55.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@turf/buffer": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "expo-server-sdk": "^6.1.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-telegram-bot-api": "^0.67.0",
    "polygon-clipping": "^0.15.7",
    "socket.io": "^4.7.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "prisma": "^6.19.3"
  },
  "overrides": {
    "request": "npm:@cypress/request@^4.0.1",
    "@cypress/request": "^4.0.1"
  },
  "engines": {
    "node": "22.x"
  }
}
