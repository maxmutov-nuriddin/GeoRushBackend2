generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String       @id @default(uuid())
  username            String       @unique
  email               String?      @unique
  phone               String?      @unique
  passwordHash        String
  teamId              String?
  team                Team?        @relation("TeamMembers", fields: [teamId], references: [id])
  ownedTeams          Team[]       @relation("TeamOwner")
  color               String       @default("#00ff88")
  avatarUrl           String?
  xp                  Int          @default(0)
  level               Int          @default(1)
  totalArea           Float        @default(0)
  totalDistance       Float        @default(0)
  territoriesCaptured Int          @default(0)
  territoriesLost     Int          @default(0)
  // Hudud kengaytirish (merge) hisobi + coin bilan sotib olingan qo'shimchalar.
  expansionsUsed      Int          @default(0)  // umrbod ishlatilgan kengaytirishlar (hisob bo'yicha jami)
  purchasedSlots      Int          @default(0)  // coin bilan olingan doimiy qo'shimcha hudud slotlari
  purchasedExpansions Int          @default(0)  // coin bilan olingan iste'mol kengaytirishlar (limitga qo'shiladi)
  purchasedTeamCreate Boolean      @default(false) // Free: coin bilan jamoa yaratish huquqi sotib olingan
  // Faol tarifni qayta olganda (uzaytirish) — bonus DARROV berilmaydi; joriy muddat tugagach ishga tushadi.
  pendingResetAt      DateTime?    // shu vaqtdan keyin kengaytirish budjeti tiklanadi + pendingCoins beriladi
  pendingCoins        Int          @default(0) // uzaytirishda kechiktirilgan welcome coinlar (yig'iladi)
  pendingTier         String?      // kechiktirilgan yangi daraja (Pro→Ultra) — joriy muddat tugagach o'tadi
  lastLocation        Json?        // GeoJSON point or simple object
  lastSeen            DateTime?
  totalPlaytimeSec    Int          @default(0)   // ilovada o'tkazilgan jami vaqt (soniya) — sessiyalar yig'indisi
  sessionCount        Int          @default(0)   // tugagan sessiyalar soni (o'rtacha = totalPlaytimeSec / sessionCount)
  city                String?
  country             String?
  isOnline            Boolean      @default(false)
  socketId            String?
  expoPushToken       String?
  termsAccepted       Boolean      @default(false)
  isAdmin             Boolean      @default(false)
  isBanned            Boolean      @default(false)
  passwordResetToken  String?
  passwordResetExpires DateTime?
  // Access-token bekor qilish uchun (logout-all / parol tiklash). JWT ichida `tv` claim
  // bilan solishtiriladi; mos kelmasa token rad etiladi. Migration: ensureCoreTables'da
  // ALTER ADD COLUMN (totalPlaytimeSec bilan bir xil xavfsiz yo'l).
  tokenVersion        Int          @default(0)

  coins               Int          @default(0)
  ownedSkins          String[]
  activeSkinColor     String?
  activeSkinMarker    String?
  activeSkinTrail     String?
  // Prestige avatar ramkasi — ustun bazaga raw SQL bilan qo'shilgan; schema'da
  // turmasa `prisma db push` uni O'CHIRADI (2026-07-02 TrafficCell saboqlari).
  activeSkinFrame     String?
  // Nik bezagi (shop type:'nick') — ensureCoreTables'da ham ALTER bor
  activeSkinNick      String?
  lastDailyClaim      DateTime?

  isPremium           Boolean      @default(false)
  premiumUntil        DateTime?
  premiumTier         String       @default("free") // "free", "pro", "ultra"
  premiumIsGift       Boolean      @default(false)
  telegramChatId      String?

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  territories         Territory[]
  createdMarkers      TeamMarker[]
  teamRequests        TeamRequest[]
  eventsAsActor       GameEvent[]  @relation("ActorEvents")
  eventsAsTarget      GameEvent[]  @relation("TargetEvents")
  antiCheatLogs       AntiCheatLog[]
  warningsReceived    Warning[]    @relation("WarningsReceived")
  warningsGiven       Warning[]    @relation("WarningsGiven")
  managedTeams        Team[]       @relation("TeamMarkerAdmins")
  refreshTokens       RefreshToken[]
  // Virtual back-relations — bazada ustun YARATMAYDI (faqat Prisma client typing).
  // MUHIM: User'ga scalar ustun qo'shish migration'siz login'ni buzadi — bular bunday emas.
  friendRequestsSent     Friendship[] @relation("FriendRequestsSent")
  friendRequestsReceived Friendship[] @relation("FriendRequestsReceived")
  referralsMade          Referral[]   @relation("ReferralsMade")
  referralReceived       Referral?    @relation("ReferralReceived")
  notifications          Notification[] @relation("UserNotifications")
  guardianWalks          GuardianSession[] @relation("GuardianWalker")
  guardianWatches        GuardianSession[] @relation("GuardianGuardian")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Do'stlik: bitta juftlik = bitta qator. requester so'rov yuborgan, addressee qabul qiluvchi.
// status: "pending" → "accepted". Rad etish/bekor qilish = qatorni o'chirish.
// Jadval prod bazada ensureCoreTables() orqali yaratiladi (db push ISHLATILMAYDI).
model Friendship {
  id          String   @id @default(uuid())
  requesterId String
  addresseeId String
  status      String   @default("pending") // "pending" | "accepted"
  requester   User     @relation("FriendRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User     @relation("FriendRequestsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

// Referral: referee ro'yxatdan o'tishda referrer kodini (username) kiritgan.
// status "pending" → referee BIRINCHI hududini egallaganda "completed" bo'lib,
// ikkala tomonga coin tushadi. Bir user faqat bir marta taklif qilinadi (refereeId unique).
model Referral {
  id         String    @id @default(uuid())
  referrerId String
  refereeId  String    @unique
  status     String    @default("pending") // "pending" | "completed"
  rewardedAt DateTime?
  referrer   User      @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referee    User      @relation("ReferralReceived", fields: [refereeId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([referrerId, status])
}

model Team {
  id                  String       @id @default(uuid())
  name                String       @unique
  tag                 String       @unique
  color               String       @default("#ff6600")
  description         String?      @default("")
  ownerId             String?
  owner               User?        @relation("TeamOwner", fields: [ownerId], references: [id])
  markerAdmins        User[]       @relation("TeamMarkerAdmins")
  isPublic            Boolean      @default(true)
  totalArea           Float        @default(0)
  memberCount         Int          @default(0)
  wins                Int          @default(0)

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  members             User[]       @relation("TeamMembers")
  territories         Territory[]
  markers             TeamMarker[]
  requests            TeamRequest[]
}

model TeamMarker {
  id                  String       @id @default(uuid())
  teamId              String
  team                Team         @relation(fields: [teamId], references: [id])
  lat                 Float
  lng                 Float
  label               String?      @default("")
  order               Int          @default(1)
  createdById         String?
  createdBy           User?        @relation(fields: [createdById], references: [id])

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model TeamRequest {
  id                  String       @id @default(uuid())
  teamId              String
  team                Team         @relation(fields: [teamId], references: [id])
  userId              String
  user                User         @relation(fields: [userId], references: [id])
  type                String       // "request", "invite"
  status              String       @default("pending") // "pending", "accepted", "declined"

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([teamId, userId, type])
}

model Territory {
  id                  String       @id @default(uuid())
  ownerId             String
  owner               User         @relation(fields: [ownerId], references: [id])
  teamId              String?
  team                Team?        @relation(fields: [teamId], references: [id])
  polygon             Json         // GeoJSON polygon structure
  area                Float
  color               String
  capturedAt          DateTime     @default(now())
  name                String?
  emoji               String?

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  events              GameEvent[]
}

model GameEvent {
  id                  String       @id @default(uuid())
  type                String
  actorId             String?
  actor               User?        @relation("ActorEvents", fields: [actorId], references: [id])
  targetId            String?
  target              User?        @relation("TargetEvents", fields: [targetId], references: [id])
  territoryId         String?
  territory           Territory?   @relation(fields: [territoryId], references: [id])
  data                Json?        // flexible data

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model AntiCheatLog {
  id                  String       @id @default(uuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id])
  type                String       // "speed", "teleport", "trail_gap", "invalid_coords"
  reason              String?      @default("")
  lat                 Float?
  lng                 Float?
  speed               Float?
  count               Int          @default(1)

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model BotSession {
  id                  String       @id @default(uuid())
  chatId              String
  type                String       // "pendingObuna", "pendingReceipt"
  expiresAt           DateTime

  createdAt           DateTime     @default(now())
  
  @@unique([chatId, type])
}

model OTPSession {
  id                  String       @id @default(uuid())
  token               String       @unique
  phone               String
  otp                 String?
  otpHash             String?
  chatId              String?      // Changed from Int to String for consistency with Telegram IDs
  otpSent             Boolean      @default(false)
  verified            Boolean      @default(false)
  purpose             String       @default("register") // "register", "reset"
  expiresAt           DateTime

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model Warning {
  id                  String       @id @default(uuid())
  userId              String
  user                User         @relation("WarningsReceived", fields: [userId], references: [id])
  adminId             String
  admin               User         @relation("WarningsGiven", fields: [adminId], references: [id])
  reason              String
  severity            String       @default("medium") // "low", "medium", "high"

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model PromoCode {
  id            String   @id @default(uuid())
  code          String   @unique
  discountPct   Int      // 0 to 100
  maxUses       Int?     // null if unlimited
  usesCount     Int      @default(0)
  expiresAt     DateTime
  isActive      Boolean  @default(true)
  // Qaysi tarif/davrga tegishli. 'all' = hammasi (orqaga moslik).
  appliesTier   String   @default("all")  // 'all' | 'pro' | 'ultra'
  appliesPeriod String   @default("all")  // 'all' | 'monthly' | 'yearly'

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Har bir HAQIQIY premium xaridi — chegirmadan keyingi to'langan summa shu yerga yoziladi.
// Admin daromad statistikasi (taxminiy emas) shu jadvaldan hisoblanadi.
model PremiumPurchase {
  id          String   @id @default(uuid())
  userId      String
  tier        String   // 'pro' | 'ultra'
  period      String   // 'monthly' | 'yearly'
  method      String   // 'stars' | 'card' | 'revenuecat'
  amountSom   Int      @default(0)  // chegirmadan keyin haqiqatda to'langan so'm
  amountStars Int      @default(0)  // Stars to'lovida — haqiqatda to'langan Stars
  baseSom     Int      @default(0)  // chegirmasiz to'liq narx (so'm)
  discountPct Int      @default(0)  // qo'llanilgan chegirma foizi
  promoCode   String?  // ishlatilgan promokod (bo'lsa)
  chargeId    String?  @unique  // provayder tranzaksiya ID'si (Telegram: telegram_payment_charge_id) — takroriy to'lov guard'i
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model SupportChat {
  id           String           @id @default(uuid())
  tgChatId     String           @unique
  tgName       String?
  tgUsername   String?
  status       String           @default("open") // "open" | "closed"
  unreadCount  Int              @default(0)
  lastMessageAt DateTime        @default(now())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  messages     SupportMessage[]
}

model SupportMessage {
  id           String       @id @default(uuid())
  chatId       String
  chat         SupportChat  @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender       String       // "user" | "admin"
  text         String
  messageId    String?      // Telegram dagi xabar ID si (ixtiyoriy)
  createdAt    DateTime     @default(now())

  @@index([chatId, createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// ⚠️ MUHIM: quyidagi 3 jadval avval FAQAT ensureCoreTables() raw-SQL'da edi va
// `prisma db push` (render startCommand'ida bor!) ularni schema'da yo'qligi uchun
// DEPLOY PAYTIDA O'CHIRIB YUBORGAN (TrafficCell ma'lumoti yo'qoldi, 2026-07-02).
// Endi schema'da turibdi — db push ularni boshqa tegmaydi. DDL ensureCoreTables bilan
// AYNAN mos (ustun tur/nomlari, pkey/index/fkey nomlari) — db push no-op bo'ladi.

// Piyoda trafik anonim agregati (trafficService.js) — ~110m katak × hafta kuni × soat.
model TrafficCell {
  cellLat   Float
  cellLng   Float
  dow       Int      @db.SmallInt
  hour      Int      @db.SmallInt
  count     Int      @default(0)
  // Eng yaqin piyoda yo'liga yopishtirilgan koordinata (OSRM nearest, lazy)
  snapLat   Float?
  snapLng   Float?
  updatedAt DateTime @default(now())

  @@id([cellLat, cellLng, dow, hour])
  @@index([count(sort: Desc)], map: "TrafficCell_count_idx")
}

// "Hamroh" (Walk Guardian) sessiyasi — joylashuv BU YERDA SAQLANMAYDI, faqat holat.
model GuardianSession {
  id         String    @id
  walkerId   String
  guardianId String
  status     String    @default("pending")
  endReason  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now())
  endedAt    DateTime?
  walker     User      @relation("GuardianWalker", fields: [walkerId], references: [id], onDelete: Cascade)
  guardian   User      @relation("GuardianGuardian", fields: [guardianId], references: [id], onDelete: Cascade)

  @@index([walkerId, status], map: "GuardianSession_walker_idx")
  @@index([guardianId, status], map: "GuardianSession_guardian_idx")
}

// Kunlik REAL piyoda yuruvchilar soni (trafficService) — userId saqlanmaydi.
model TrafficDaily {
  date      String   @id
  walkers   Int      @default(0)
  updatedAt DateTime @default(now())
}

// Kunlik sessiya agregati (admin dashboard "Bugungi faollik").
model DailyStat {
  date         String   @id
  playtimeSec  BigInt   @default(0)
  sessionCount Int      @default(0)
  updatedAt    DateTime @default(now())
}

model SystemFlag {
  key       String   @id
  createdAt DateTime @default(now())
}

// ── "Oila Doirasi" (Family Circle) — doimiy oilaviy xavfsizlik ──────────────────
// Hamroh (GuardianSession) bir martalik/sessiyaviy; Oila Doirasi doimiy holat saqlaydi.
// MAXFIYLIK: xom GPS trace SAQLANMAYDI — faqat nomlangan zonalarga kirish/chiqish voqealari
// (vaqt + zona). Kirish/chiqish aniqlash locationHandler hot-path'ida (familyCircleService).
// Kirish raw SQL orqali (guardianService uslubi) — bu modellar db-push himoyasi uchun,
// prisma client'da relation kerak emas (userId/circleId oddiy String ustunlar).
model FamilyCircle {
  id         String   @id
  name       String
  ownerId    String
  inviteCode String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  @@index([ownerId], map: "FamilyCircle_owner_idx")
}

model FamilyCircleMember {
  id        String   @id
  circleId  String
  userId    String
  role      String   @default("child") // "parent" | "child"
  createdAt DateTime @default(now())

  @@unique([circleId, userId], map: "FamilyCircleMember_circle_user_key")
  @@index([userId], map: "FamilyCircleMember_user_idx")
}

model FamilyZone {
  id          String   @id
  circleId    String
  label       String
  lat         Float
  lng         Float
  radiusM     Int      @default(120)
  createdById String
  createdAt   DateTime @default(now())

  @@index([circleId], map: "FamilyZone_circle_idx")
}

// Zona kirish/chiqish voqeasi (tarix). zoneLabel — snapshot (zona o'chsa ham tarix qoladi).
model FamilyZoneEvent {
  id        String   @id
  circleId  String
  zoneId    String
  userId    String
  zoneLabel String
  kind      String   // "enter" | "exit"
  at        DateTime @default(now())

  @@index([circleId, at], map: "FamilyZoneEvent_circle_at_idx")
}
