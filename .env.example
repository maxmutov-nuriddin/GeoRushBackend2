PORT=3001
NODE_ENV=development

# PostgreSQL + PostGIS (Prisma)
# DIRECT_URL — pgbouncer (Supabase) ishlatilganda prisma migrate uchun to'g'ridan-to'g'ri ulanish
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/georush_db?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/georush_db?schema=public"

# Scale-out (ixtiyoriy): Redis adapter + ko'p instance rejimi (qarang: SCALING.md)
# REDIS_URL=redis://localhost:6379
# BOT_POLLING=false  # qo'shimcha instance'larda bot polling o'chiriladi

# Sentry (ixtiyoriy)
# SENTRY_DSN=

# JWT — kamida 64 belgili random string (node -e "require('crypto').randomBytes(64).toString('hex').slice(0,64)|xargs echo")
JWT_SECRET=your-super-secret-jwt-key-at-least-64-chars-long
JWT_EXPIRES_IN=7d

# PII field-shifrlash (phone/telegram/email/lastLocation) — 64 belgili hex (32 bayt).
# Generatsiya: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Bo'sh qoldirilsa shifrlash O'CHIQ (passthrough). O'rnatgandan keyin BIR MARTA:
#   node scripts/encrypt-existing-pii.js --apply
# DIQQAT: kalitni YO'QOTSANGIZ shifrlangan ma'lumotni ocholmaysiz — zaxira saqlang!
ENCRYPTION_KEY=

# Frontend origin (CORS)
FRONTEND_URL=http://localhost:5173
# Admin paneli origin (CORS)
ADMIN_URL=http://localhost:5174
# Landing sahifa origin (CORS — "Bog'lanish" formasi /api/contact ga so'rov yuboradi)
LANDING_URL=http://localhost:5175

# Anti-abuse: har AUTH qilingan foydalanuvchi uchun API so'rov chegarasi (daqiqada).
# Oddiy o'yin ≈30/daq (jonli xarita socketда — sanoqqa kirmaydi). Default 300 (~10x zaxira).
USER_RATE_LIMIT_PER_MIN=300

# Game Config (TERRITORY_MIN/MAX_AREA olib tashlandi — kod constants.js'дagi qattiq qiymatни ishlatadi)
MAX_TRAIL_POINTS=5000
MAX_PLAYER_SPEED_MS=10
LOCATION_UPDATE_INTERVAL_MS=2000

# Telegram Bot (OTP tasdiqlash + support)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Support bot (ALOHIDA bot — OTP botdan farqli token, aks holда polling konflikti).
# Yo'q bo'lsa support-bot o'chiq turadi. SUPPORT_BOT_USERNAME — OTP botдagi "🆘 Yordam"
# tugmasi shu botга havola beradi (t.me/<username>).
SUPPORT_BOT_TOKEN=your-support-bot-token
SUPPORT_BOT_USERNAME=your_support_bot_username
SUPPORT_CHAT_ID=your-admin-group-or-chat-id

# (Email OLIB TASHLANDI — emailService.js o'lik kod edi, hech qayerда ishlatilmasdi.
#  Parol tiklash Telegram OTP orqali. Kelajakда email kerak bo'lsa qayta qo'shiladi.)

# Trail HMAC (ixtiyoriy — yo'q bo'lsa JWT_SECRET ishlatiladi)
# TRAIL_HMAC_SECRET=separate-secret-for-trail-signing

# (PREMIUM_CARD_* / PREMIUM_AMOUNT / PREMIUM_ADMIN_TG_ID OLIB TASHLANDI —
#  eski karta-to'lov qoldig'i, kodда ishlatilmaydi. Endi faqat Telegram Stars.)

# ── So'mda to'lov: Click / Payme (tanga paketlari, Starter Pack) ──────────────
# Kalit bo'lmasa provayder o'chiq turadi (checkout 503). Callback URL'lar provayder kabinetida:
#   Payme:  https://<backend>/api/payments/payme
#   Click:  https://<backend>/api/payments/click/prepare  va  .../click/complete
# PAYME_MERCHANT_ID=
# PAYME_KEY=                      # kassa kaliti (test rejimida — test kaliti)
# PAYME_CHECKOUT_URL=https://checkout.paycom.uz   # test: https://checkout.test.paycom.uz
# PAYME_ACCOUNT_FIELD=order_id
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_SECRET_KEY=
# PAYMENT_RETURN_URL=https://<frontend>/shop?payment=done
#
# PayGate (o'z serverimiz: karta → karta, Telegram karta-bot tasdig'i)
# PAYGATE_URL=https://paymentconfirment.onrender.com
# PAYGATE_SHOP_ID=georush_3342
# PAYGATE_SHOP_KEY=sk_...
# PAYGATE_CALLBACK_URL=https://georush.uz/pay/callback
# PAYGATE_CARD_HOLDER=ISM FAMILIYA  # mijozga ko'rsatiladi (PayGate CARD_HOLDER)
