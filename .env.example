PORT=3001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/geowar?retryWrites=true&w=majority

# JWT — kamida 64 belgili random string (node -e "require('crypto').randomBytes(64).toString('hex').slice(0,64)|xargs echo")
JWT_SECRET=your-super-secret-jwt-key-at-least-64-chars-long
JWT_EXPIRES_IN=7d

# Frontend origin (CORS)
FRONTEND_URL=http://localhost:5173
# Admin paneli origin (CORS)
ADMIN_URL=http://localhost:5174
# Landing sahifa origin (CORS — "Bog'lanish" formasi /api/contact ga so'rov yuboradi)
LANDING_URL=http://localhost:5175

# Game Config
MAX_TRAIL_POINTS=500
TERRITORY_MIN_AREA=100
TERRITORY_MAX_AREA=5000000
MAX_PLAYER_SPEED_MS=12
LOCATION_UPDATE_INTERVAL_MS=2000

# Telegram Bot (OTP tasdiqlash + support)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Email (parol tiklash uchun — ixtiyoriy, yo'q bo'lsa reset link log'ga chiqadi)
# Gmail misol: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_SECURE=false
# App Password: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=GeoRush <your-email@gmail.com>

# Trail HMAC (ixtiyoriy — yo'q bo'lsa JWT_SECRET ishlatiladi)
# TRAIL_HMAC_SECRET=separate-secret-for-trail-signing

# Premium obuna to'lov ma'lumotlari (bot orqali yuboriladi, 15 daqiqada o'chadi)
PREMIUM_CARD_NUMBER=8600 0000 0000 0000
PREMIUM_CARD_OWNER=Ism Familiya
PREMIUM_AMOUNT=14900
PREMIUM_ADMIN_TG_ID=your-admin-telegram-id
